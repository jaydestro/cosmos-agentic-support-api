{
  "name": "resolve-sample",
  "version": "1.0.0",
  "private": true,
  "description": "Resolve: a synthetic SaaS billing-dispute sample with an approval-gated, simulated credit.",
  "type": "module",
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "contract:lint": "redocly lint contracts/openapi.yaml",
    "contract:generate": "node tools/contract/generate.ts",
    "contract:check": "node tools/contract/generate.ts --check",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "build": "node tools/build/build.ts",
    "package": "node tools/build/package.ts",
    "seed": "node tools/seed/main.ts",
    "stack:up": "node tests/support/cli.ts up",
    "stack:down": "node tests/support/cli.ts down",
    "stack:run": "node tests/support/cli.ts run",
    "stack:status": "node tests/support/cli.ts status",
    "test": "npm run test:unit",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "test:integration": "node tests/support/cli.ts run -- node --test --test-concurrency=1 \"tests/integration/**/*.test.ts\"",
    "test:e2e": "node tests/support/cli.ts run -- node --test --test-concurrency=1 \"tests/e2e/**/*.test.ts\"",
    "test:service": "npm run test:integration && npm run test:e2e",
    "test:safety": "node --test \"tests/safety/**/*.test.ts\"",
    "scan:secrets": "node tests/support/safety.ts secrets",
    "contract:breaking": "node tests/support/safety.ts breaking",
    "infra:check": "az bicep lint --file infra/main.bicep && az bicep build --file infra/main.bicep --outfile infra/main.json && az bicep lint --file infra/identities.bicep && az bicep build --file infra/identities.bicep --outfile infra/identities.json && az bicep lint --file infra/deployment-access.bicep && az bicep build --file infra/deployment-access.bicep --outfile infra/deployment-access.json",
    "test:infra": "node --test \"tests/infra/**/*.test.ts\"",
    "workflows:compile": "gh aw compile contract-cosmos-review docs-maintainer",
    "workflows:check": "node tests/support/workflows.ts",
    "check": "npm run contract:lint && npm run contract:check && npm run typecheck && npm run lint && npm test && npm audit && npm run build && npm run package",
    "check:all": "npm run check && npm run infra:check && npm run test:infra && npm run workflows:check && npm run scan:secrets && npm run test:safety && npm run test:service"
  },
  "dependencies": {
    "@azure/cosmos": "4.10.1",
    "@azure/functions": "4.17.0",
    "@azure/identity": "4.14.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jose": "6.2.13",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@azure/msal-browser": "5.27.0",
    "@eslint/js": "10.0.1",
    "@redocly/cli": "2.69.0",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "openapi-fetch": "0.17.0",
    "openapi-typescript": "7.13.0",
    "playwright-core": "1.64.1",
    "swagger-ui-dist": "5.34.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  },
  "allowScripts": {
    "@scarf/scarf": false,
    "esbuild": false
  }
}
